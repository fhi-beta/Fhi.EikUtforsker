<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="Legemiddelregisteret" value="https://fhi.pkgs.visualstudio.com/_packaging/Legemiddelregisteret/nuget/v3/index.json" />
	</packageSources>
	<packageSourceCredentials>
		<Legemiddelregisteret>
			<add key="Username" value="GitHubActions" />
			<add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
		</Legemiddelregisteret>
	</packageSourceCredentials>
</configuration>